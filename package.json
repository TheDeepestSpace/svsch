{
  "name": "svsch",
  "displayName": "svsch",
  "description": "Generate interactive visual block diagrams from SystemVerilog projects.",
  "version": "0.2.2",
  "publisher": "thedeepestspace",
  "license": "AGPL-3.0",
  "bin": {
    "svsch": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDeepestSpace/svsch"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:svsch.openDiagram",
    "onCommand:svsch.setProjectFolder",
    "onCommand:svsch.rebuildDiagram",
    "onCommand:svsch.resetLayout"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "svsch.openDiagram",
        "title": "svsch: Open Diagram"
      },
      {
        "command": "svsch.setProjectFolder",
        "title": "svsch: Set Project Folder"
      },
      {
        "command": "svsch.rebuildDiagram",
        "title": "svsch: Rebuild Diagram"
      },
      {
        "command": "svsch.resetLayout",
        "title": "svsch: Reset Layout For Current Module"
      }
    ],
    "configuration": {
      "title": "svsch",
      "properties": {
        "svsch.projectFolder": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative folder containing SystemVerilog/Verilog sources."
        },
        "svsch.veriblePath": {
          "type": "string",
          "default": "verible-verilog-syntax",
          "description": "Path to the Verible verible-verilog-syntax executable."
        },
        "svsch.surelogPath": {
          "type": "string",
          "default": "surelog",
          "description": "Path to the Surelog executable."
        },
        "svsch.parser.backend": {
          "type": "string",
          "enum": [
            "uhdm",
            "verible",
            "fallback"
          ],
          "default": "uhdm",
          "description": "Parser backend used to extract the design graph."
        },
        "svsch.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative paths to search for include files."
        },
        "svsch.defines": {
          "type": "object",
          "default": {},
          "description": "Macros to define for the preprocessor (e.g. { \"DEBUG\": \"1\" })."
        },
        "svsch.autocut-clk-reset": {
          "type": "boolean",
          "default": true,
          "description": "Automatically cut nets feeding register clock and reset pins when a module diagram is first opened."
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf media dist node_modules/.vite src/parser/backend_cpp/build",
    "build": "npm run compile",
    "compile": "npm run clean && CI=true npx vite build && npx tsc -p tsconfig.extension.json && npm run compile:backend && SURELOG_AUTO_INSTALL=1 npm run install-surelog && npm run build:cli",
    "build:webview": "CI=true npx vite build",
    "build:extension": "npx tsc -p tsconfig.extension.json",
    "build:cli": "npx vite build --config vite.config.cli.ts",
    "compile:backend": "mkdir -p src/parser/backend_cpp/build && cd src/parser/backend_cpp/build && cmake .. -G Ninja && ninja svsch_backend && mkdir -p ../../../../dist/ && cp svsch_backend ../../../../dist/",
    "package": "SURELOG_AUTO_INSTALL=1 npm run compile && npx vsce package",
    "release": "SURELOG_AUTO_INSTALL=1 npm run compile && npx changeset publish",
    "watch": "vite build --watch & tsc -watch -p tsconfig.extension.json",
    "lint": "tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.cli.json",
    "test": "vitest run",
    "test:backend": "node scripts/run-backend-tests.js",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "bundle-surelog": "node scripts/bundle-surelog.js --src \"$SURELOG_SRC\"",
    "install-surelog": "node scripts/install-surelog.js",
    "prepare": "node scripts/install-surelog.js || true && patch-package",
    "test:bdd": "env -u ELECTRON_RUN_AS_NODE xvfb-run --auto-servernum playwright test --config test/bdd/playwright.config.ts",
    "test:bdd:update": "env -u ELECTRON_RUN_AS_NODE xvfb-run --auto-servernum playwright test --config test/bdd/playwright.config.ts --update-snapshots",
    "test:bdd:headed": "scripts/start-vnc.sh",
    "test:system:single": "env -u ELECTRON_RUN_AS_NODE xvfb-run --auto-servernum playwright test --config test/system/playwright.config.ts",
    "test:system:single:update": "env -u ELECTRON_RUN_AS_NODE xvfb-run --auto-servernum playwright test --config test/system/playwright.config.ts --update-snapshots",
    "test:system": "node scripts/run-system-tests.js",
    "test:system:update": "node scripts/run-system-tests.js --update-snapshots",
    "docs:generate": "tsx test/scripts/generate-docs.mts",
    "docs:syntax": "GENERATE_SYNTAX_BOOK=1 playwright test --config test/syntax-book/playwright.config.ts",
    "test:syntax": "playwright test --config test/syntax-book/playwright.config.ts",
    "visual:serve": "vite --host 127.0.0.1 --port 5176"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@xyflow/react": "^12.10.2",
    "elkjs": "^0.12.0",
    "libavoid-js": "^0.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "1.62.0",
    "@types/diff": "^8.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/vsce": "^3.2.1",
    "diff": "^9.0.0",
    "js-yaml": "^5.2.1",
    "jsdom": "^30.0.0",
    "multiple-cucumber-html-reporter": "^4.0.0",
    "patch-package": "^8.0.1",
    "pixelmatch": "^7.1.0",
    "playwright-bdd": "^9.0.0",
    "pngjs": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.0",
    "vscode-test-playwright": "^0.0.1-beta2"
  },
  "overrides": {
    "fast-uri": "^3.1.4",
    "linkify-it": "^5.0.2",
    "semver": "^7.5.2",
    "uuid": "^14.0.0",
    "@changesets/parse": {
      "js-yaml": "^4.3.1"
    },
    "@textlint/linter-formatter": {
      "js-yaml": "^4.3.1"
    },
    "rc-config-loader": {
      "js-yaml": "^4.3.1"
    },
    "read-yaml-file": {
      "js-yaml": "^3.15.1"
    }
  }
}
