{
  "compilerOptions": {
    "module": "node16",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "dom"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "noUncheckedSideEffectImports": false,
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "types": [
      "node",
      "vscode"
    ],
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/cli/svgRenderer.ts"
  ],
  "exclude": [
    "src/webview/main.tsx",
    "src/webview/expand/expandOverlay.ts",
    "src/webview/nodes/HdlNode.tsx",
    "src/webview/nodes/MiniMapNode.tsx",
    "src/webview/nodes/NetLabelNode.tsx",
    "src/webview/nodes/index.ts",
    "src/webview/nodes/types.ts",
    "src/webview/nodes/alu/AluNode.tsx",
    "src/webview/nodes/comb/CombNode.tsx",
    "src/webview/nodes/comparator/ComparatorNode.tsx",
    "src/webview/nodes/instance/InstanceNode.tsx",
    "src/webview/nodes/inverter/InverterNode.tsx",
    "src/webview/nodes/literal/LiteralNode.tsx",
    "src/webview/nodes/mux/MuxNode.tsx",
    "src/webview/nodes/port/PortNode.tsx",
    "src/webview/nodes/register/RegisterNode.tsx",
    "src/webview/nodes/replicate/ReplicateNode.tsx",
    "src/webview/nodes/zext/ZextNode.tsx",
    "src/webview/nodes/shared/context.tsx",
    "src/webview/nodes/shared/skins.tsx",
    "src/webview/nodes/shared/ExpandGrabBands.tsx",
    "src/webview/nodes/shared/HdlNodeBase.tsx",
    "src/webview/nodes/shared/InputPortHandles.tsx",
    "src/webview/nodes/shared/NodeResizeControls.tsx",
    "src/webview/nodes/shared/NodeWarningIcon.tsx",
    "src/webview/orthogonal/OrthogonalEdge.tsx",
    "src/webview/orthogonal/index.ts",
    "src/parser/backend_cpp/build/**"
  ]
}
