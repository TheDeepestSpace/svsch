{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": false,
    "moduleResolution": "node16",
    "types": ["node"]
  },
  "include": ["./**/*.ts"]
}
